{
  "name": "@bionicsv/grammy-dialogs",
  "version": "0.1.0",
  "description": "Type-safe dialog manager for grammY, inspired by aiogram-dialog",
  "keywords": [
    "grammy",
    "telegram",
    "bot",
    "dialog",
    "state-machine",
    "typescript",
    "i18n"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bionicsv26/grammy-dialogs.git"
  },
  "bugs": {
    "url": "https://github.com/bionicsv26/grammy-dialogs/issues"
  },
  "homepage": "https://github.com/bionicsv26/grammy-dialogs#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch examples/bot/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "grammy": "^1.46.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@grammyjs/runner": "^2.0.3",
    "@grammyjs/storage-redis": "^2.6.0",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "grammy": "^1.46.0",
    "https-proxy-agent": "^9.1.0",
    "ioredis": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7"
  }
}
